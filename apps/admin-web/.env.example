# Admin web — copy this file to `.env` and edit.

# Backend API base URL (Firestore via api-server — all data is live).
VITE_API_BASE_URL=http://localhost:4000

# Firebase web config — required for admin sign-in
# (same Firebase project as the mobile app + api-server).
# Find these in Firebase Console → Project settings → General → Your apps.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
