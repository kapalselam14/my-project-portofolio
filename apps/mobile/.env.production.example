# MatchUp mobile — production environment template.
# Copy to `.env` (same directory, gitignored) to run the app against the
# hosted backend instead of localhost. `.env` itself is never committed.
#
# Values:
#   API_BASE_URL — Cloud Run service URL (see infra deploy output).
#   APP_ENV      — anything but `local` enforces https (OWASP M5).
#   FIREBASE_WEB_API_KEY — Firebase Console → Project Settings → Web API Key
#     (public client key, safe to share with the team; the service-account
#     private key must NEVER go here).
#   USE_REMOTE_API — always `true`; local dummy mode was removed.

API_BASE_URL=https://matchup-api-569237066208.asia-southeast1.run.app
APP_ENV=production
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
USE_REMOTE_API=true
