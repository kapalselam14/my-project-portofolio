rules_version = '2';

// MatchUp Firestore rules — default deny for ALL clients.
//
// Every Firestore read/write in this project goes through `apps/api-server`
// (Admin SDK, which bypasses rules entirely):
//   - mobile app: Firestore is never touched directly (RTDB + Storage only)
//   - admin web: HTTPS API only (`apiFetch`)
//   - seed scripts: Admin SDK
//
// The deny-all default is load-bearing for moderation:
//   - `users/{uid}.status` ('active' | 'suspended') can only be written by
//     the admin API — a suspended user cannot clear their own flag, because
//     no client token grants ANY Firestore write.
//   - `broadcasts`, `sports`, `notificationTemplates`, `reports` are
//     admin-curated; clients have no business writing them.
//
// `firestore.get()` lookups inside `storage.rules` keep working: rule
// evaluation reads are not client access and ignore these rules.
//
// Escape hatch (deliberate, do it explicitly when needed): if the mobile
// app ever reads the sports config directly, open that collection
// read-only, e.g.
//   match /sports/{sportId} {
//     allow read: if request.auth != null;
//     allow write: if false;
//   }
// Never open client writes without an allowlisted-field review.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
