# =========================================================================
# MatchUp — root environment variables
# Copy this file to `.env` (or app-specific `.env`) and fill in the values.
# Variables consumed by each app are documented below.
# =========================================================================

# -------------------------- API (apps/api-server, Firebase) --------------------------
# Port the Express API listens on
PORT=4000

# Firebase Admin SDK (Service account → Firebase Console → Project settings)
# Auth is Firebase ID tokens verified server-side — no self-signed JWT
# secret is needed (a former AUTH_SECRET var was removed as dead).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Admin access: Firestore `admins` collection (doc id = Firebase auth uid).
# ADMIN_UIDS below is only the bootstrap fallback for the first admin.
ADMIN_UIDS=

# Node environment: development | test | production
NODE_ENV=development

# CORS: comma-separated browser origins allowed to call the API.
# Unset/empty = allow all origins (permissive default, warns at startup).
# Set this in production, e.g. CORS_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ORIGINS=

# -------------------------- Admin Web --------------------------
# Base URL the admin web uses to call the API
VITE_API_BASE_URL=http://localhost:4000

# -------------------------- Mobile --------------------------
# API base URL the Flutter app uses
API_BASE_URL=http://localhost:4000

# Mobile environment label: local | staging | production
APP_ENV=local