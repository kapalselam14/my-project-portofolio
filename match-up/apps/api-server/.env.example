# MatchUp api-server — copy to `.env` and fill in Firebase values.
# Service-account fields come from Firebase Console → Project settings → Service accounts.
PORT=4000
NODE_ENV=development

# Auth is Firebase ID tokens verified server-side — no JWT secret needed.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Admin access: Firestore `admins` collection (doc id = Firebase auth uid) is
# the primary source — add/remove admins in Firebase Console, no restart.
# This env is only the bootstrap fallback for the very first admin.
# (Client SDK access to `admins` is denied by firestore.rules; the server
# reads it via the Admin SDK, which bypasses rules.)
ADMIN_UIDS=

# CORS: comma-separated browser origins allowed to call the API.
# Unset/empty = allow all origins (permissive default, warns at startup).
# Set this in production, e.g. CORS_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ORIGINS=
