<?xml version="1.0" encoding="utf-8"?>
<!--
  OWASP M5 — Insecure Communication mitigation.
  Blocks all cleartext (HTTP) traffic except to localhost (10.0.2.2 for
  Android emulator, 127.0.0.1 for physical device USB debugging).
  All production traffic MUST use HTTPS.
-->
<network-security-config>

    <!-- Production: HTTPS only, system trust store -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Local dev: allow HTTP to localhost / emulator host only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
