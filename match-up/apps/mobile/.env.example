# MatchUp mobile — local environment variables
# Copy this file to `.env` (in the same directory) and edit values.
# Note: `.env` is gitignored by the root .gitignore.

API_BASE_URL=http://localhost:4000
APP_ENV=local
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Set to `true` to hit the live backend instead of in-memory dummy data.
USE_REMOTE_API=true